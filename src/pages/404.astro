---
import MainLayout from '@/layouts/MainLayout.astro';
import Link from '@/components/ui/Link.astro';
import { SITE } from '@/config/site';
---

<MainLayout
  title={`頁面不存在 - ${SITE.name}`}
  description='抱歉，您要找的頁面不存在。'
  class='min-h-screen bg-slate-900'
>
  <div class='max-w-4xl mx-auto text-center py-20 px-8'>
    <h1 class='text-9xl font-bold text-slate-600 mb-8'>404</h1>

    <h2 class='text-3xl font-bold text-white mb-4'>頁面不存在</h2>
    <p class='text-xl text-slate-300 mb-8 max-w-2xl mx-auto'>
      抱歉，您要找的頁面可能已被移動、刪除或從未存在過。
    </p>

    <div class='flex flex-wrap justify-center gap-4'>
      <Link
        href='/'
        class='bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors inline-block'
      >
        回到首頁
      </Link>
      <Link
        href='/blog'
        class='border border-slate-500 text-slate-300 px-8 py-3 rounded-lg font-semibold hover:bg-slate-800 transition-colors inline-block'
      >
        瀏覽文章
      </Link>
    </div>
  </div>
</MainLayout>
