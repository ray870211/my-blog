---
import MainLayout from '@/layouts/MainLayout.astro';
import Link from '@/components/ui/Link.astro';
import PostListItem from '@/components/blog/PostListItem.astro';
import TagSidebar from '@/components/blog/TagSidebar.astro';
import {
  getPublishedPosts,
  filterByTag,
  getUniqueTags,
  type BlogPost,
} from '@/utils/posts';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const tags = getUniqueTags(allPosts);

  return tags.map(tag => ({
    params: { tag },
    props: {
      posts: filterByTag(allPosts, tag),
      tag,
      allPosts,
    },
  }));
}

interface Props {
  posts: BlogPost[];
  tag: string;
  allPosts: BlogPost[];
}

const { posts, tag, allPosts } = Astro.props;
---

<MainLayout
  title={`${tag} 標籤 - ${SITE.name}`}
  description={`查看所有標籤為 ${tag} 的文章`}
  class='min-h-screen bg-slate-900'
>
  <div class='max-w-6xl mx-auto px-8 py-8'>
    <div class='mb-12'>
      <h1 class='text-4xl font-bold text-white mb-4'>#{tag}</h1>
      <p class='text-xl text-slate-300'>共找到 {posts.length} 篇文章</p>
      <Link
        href='/blog'
        class='inline-block mt-4 text-blue-400 hover:text-blue-300 transition-colors'
      >
        ← 返回所有文章
      </Link>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <div class='lg:col-span-3'>
        {
          posts.map((post, index) => (
            <PostListItem
              post={post}
              isLast={index === posts.length - 1}
              activeTag={tag}
            />
          ))
        }

        {
          posts.length === 0 && (
            <div class='text-center py-12'>
              <p class='text-slate-400 text-lg'>此標籤下沒有文章</p>
            </div>
          )
        }
      </div>

      <TagSidebar
        posts={allPosts}
        activeTag={tag}
      />
    </div>
  </div>
</MainLayout>
