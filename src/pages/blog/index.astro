---
import MainLayout from '@/layouts/MainLayout.astro';
import PostListItem from '@/components/blog/PostListItem.astro';
import TagSidebar from '@/components/blog/TagSidebar.astro';
import { getPublishedPosts } from '@/utils/posts';
import { SITE } from '@/config/site';

const sortedPosts = await getPublishedPosts();
---

<MainLayout
  title={`部落格 - ${SITE.name}`}
  description='分享技術心得與生活感悟的部落格文章'
>
  <div class='max-w-6xl mx-auto px-8 py-8'>
    <div class='mb-4'>
      <h1 class='text-4xl font-bold text-white mb-4'>Articles</h1>
    </div>

    <div class='grid grid-cols-1 lg:grid-cols-4 gap-8'>
      <div class='lg:col-span-3'>
        {
          sortedPosts.map((post, index) => (
            <PostListItem
              post={post}
              isLast={index === sortedPosts.length - 1}
            />
          ))
        }

        {
          sortedPosts.length === 0 && (
            <div class='text-center py-12'>
              <p class='text-slate-400 text-lg'>目前還沒有文章</p>
            </div>
          )
        }
      </div>

      <TagSidebar posts={sortedPosts} />
    </div>
  </div>
</MainLayout>
