---
import MainLayout from '@/layouts/MainLayout.astro';
import Link from '@/components/ui/Link.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import PostCard from '@/components/blog/PostCard.astro';
import { getPublishedPosts } from '@/utils/posts';
import { SITE } from '@/config/site';

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<MainLayout
  title={SITE.title}
  description={SITE.description}
>
  <div class='max-w-4xl mx-auto px-8 py-12'>
    <section class='mb-16'>
      <div class='max-w-2xl mx-auto text-center'>
        <h1 class='text-3xl font-bold text-white mb-6'>Ray</h1>

        <p class='text-md text-slate-300 mb-8 leading-relaxed'>
          喜歡前端的工程師。 在這裡分享我的技術學習心得、AI 探索過程，以及一些些生活感悟。
        </p>
        <p class='text-md text-slate-300 mb-8 leading-relaxed'>
          這個部落格就是我拿來整理思緒、紀錄學習、偶爾碎念的地方。沒有一定多專業，但盡量寫清楚為什麼這樣做、為什麼選這個工具，能幫到正在摸索的人就更好了。
        </p>
      </div>

      <div class='flex justify-center space-x-4 mb-8'>
        <Link
          href='/blog'
          class='bg-slate-700 text-white px-8 py-3 rounded-lg font-semibold hover:bg-slate-600 transition-all duration-300'
        >
          瀏覽文章
        </Link>
      </div>

      <SocialLinks
        class='flex justify-center space-x-6'
        iconClass='w-6 h-6'
      />
    </section>

    {
      recentPosts.length > 0 && (
        <section>
          <h2 class='text-3xl font-bold text-white mb-8 text-center'>最新文章</h2>
          <div class='grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12'>
            {recentPosts.map(post => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</MainLayout>
