---
import Link from '@/components/ui/Link.astro';
import SocialLinks from '@/components/ui/SocialLinks.astro';
import { SITE } from '@/config/site';
---

<header class='border-b border-slate-700 h-16 fixed top-0 left-0 right-0 z-50 backdrop-blur-sm'>
  <div class='px-6 h-full flex items-center justify-between w-full'>
    <div class='p-6'>
      <h1 class='text-xl font-bold text-white'>
        <Link
          href='/'
          class='hover:text-blue-400 transition-colors'
        >{SITE.shortName}</Link>
      </h1>
    </div>
    <SocialLinks />
  </div>
</header>
