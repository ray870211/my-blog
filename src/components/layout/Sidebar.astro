---
import Link from '@/components/ui/Link.astro';
import Icon from '@/components/ui/Icon.astro';
import { getPublishedPosts, getUniqueTags } from '@/utils/posts';
import { SIDEBAR_NAV } from '@/config/site';

const allPosts = await getPublishedPosts();
const recentPosts = allPosts.slice(0, 5);
const tags = getUniqueTags(allPosts);

const currentPath = Astro.url.pathname;
---

<aside
  id='sidebar'
  class='w-64 bg-slate-800 min-h-screen fixed left-0 top-16 overflow-y-auto border-r border-slate-700 lg:translate-x-0 transition-transform duration-300 z-40'
  aria-label='側邊欄'
>
  <nav class='p-4'>
    <div class='sidebar-section'>
      <h3>近期文章</h3>
      <div class='space-y-1'>
        {
          recentPosts.map(post => (
            <Link
              href={`/blog/${post.slug}`}
              class={`nav-item text-sm ${currentPath === `/blog/${post.slug}` ? 'active' : ''}`}>
              {post.data.title}
            </Link>
          ))
        }
      </div>
    </div>

    <div class='sidebar-section'>
      <button
        id='categories-toggle'
        type='button'
        class='flex items-center justify-between w-full text-left'
        aria-controls='categories-content'
        aria-expanded='true'
        aria-label='切換 Code 分類'
      >
        <h3>Code</h3>
        <Icon
          name='chevron-down'
          class='w-4 h-4 text-slate-400 transform transition-transform'
        />
      </button>
      <div
        id='categories-content'
        class='space-y-1 mt-2'
      >
        <Link
          href='/blog'
          class={`nav-item text-sm ${currentPath === '/blog' ? 'active' : ''}`}
        >
          近期文章
        </Link>
        {
          recentPosts.slice(0, 3).map(post => (
            <Link
              href={`/blog/${post.slug}`}
              class={`nav-item text-sm ml-4 ${currentPath === `/blog/${post.slug}` ? 'active' : ''}`}>
              {post.data.title}
            </Link>
          ))
        }
      </div>
    </div>

    {
      tags.length > 0 && (
        <div class='sidebar-section'>
          <h3>標籤</h3>
          <div class='space-y-1'>
            {tags.slice(0, 6).map(tag => (
              <Link
                href={`/blog/tag/${tag}`}
                class={`nav-item text-sm ${currentPath === `/blog/tag/${tag}` ? 'active' : ''}`}>
                #{tag}
              </Link>
            ))}
          </div>
        </div>
      )
    }

    <div class='sidebar-section'>
      <h3>關於</h3>
      <div class='space-y-1'>
        {
          SIDEBAR_NAV.map(item => (
            <Link
              href={item.href}
              class={`nav-item text-sm ${currentPath === item.href ? 'active' : ''}`}
              target={item.external ? '_blank' : undefined}>
              {item.name}
            </Link>
          ))
        }
      </div>
    </div>
  </nav>
</aside>

<script>
  function initCategoryToggle() {
    const toggle = document.getElementById('categories-toggle');
    const content = document.getElementById('categories-content');
    if (!toggle || !content) return;
    const icon = toggle.querySelector('svg');

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      content.classList.toggle('hidden');
      icon?.classList.toggle('rotate-180');
    });
  }

  document.addEventListener('DOMContentLoaded', initCategoryToggle);
  document.addEventListener('astro:page-load', initCategoryToggle);
</script>
