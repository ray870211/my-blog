---
import Chip from '@/components/ui/Chip.astro';
import Icon from '@/components/ui/Icon.astro';
import Link from '@/components/ui/Link.astro';
import PostMeta from '@/components/ui/PostMeta.astro';
import type { BlogPost } from '@/utils/posts';

interface Props {
  post: BlogPost;
  isLast?: boolean;
  activeTag?: string;
}

const { post, isLast = false, activeTag } = Astro.props;
---

<article
  class={`py-6 md:py-8 transition-all duration-300 hover:bg-slate-900/20 md:hover:px-4 md:hover:mx-[-1rem] md:hover:rounded-lg ${
    isLast ? '' : 'border-b border-slate-700/30'
  }`}
>
  <header class='mb-4'>
    <h2
      class='text-2xl font-bold text-white mb-3 leading-tight'
      style={`view-transition-name: post-title-${post.slug}`}
    >
      <Link
        href={`/blog/${post.slug}`}
        class='hover:text-slate-300 transition-colors'
      >
        {post.data.title}
      </Link>
    </h2>

    <PostMeta
      post={post}
      content={post.body}
      class='mb-3'
    />
  </header>

  <p class='text-slate-300 leading-relaxed mb-4 text-base'>
    {post.data.description}
  </p>

  {
    post.data.tags && post.data.tags.length > 0 && (
      <div class='flex flex-wrap gap-2 mb-4'>
        {post.data.tags.map(tag => (
          <Chip
            tag={tag}
            href={`/blog/tag/${tag}`}
            variant={tag === activeTag ? 'active' : 'secondary'}
            size='sm'
          />
        ))}
      </div>
    )
  }

  <Link
    href={`/blog/${post.slug}`}
    class='inline-flex items-center text-slate-400 hover:text-white font-medium transition-all duration-300 group'
  >
    閱讀更多
    <Icon
      name='arrow-right'
      class='ml-1 w-4 h-4 transition-transform group-hover:translate-x-1'
    />
  </Link>
</article>
