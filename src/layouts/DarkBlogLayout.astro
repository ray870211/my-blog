---
import MainLayout from './MainLayout.astro';
import Chip from '@/components/ui/Chip.astro';
import Link from '@/components/ui/Link.astro';
import PostMeta from '@/components/ui/PostMeta.astro';
import type { BlogPost } from '@/utils/posts';

interface Props {
  post: BlogPost;
  content?: string;
}

const { post, content = '' } = Astro.props;
const { title, description, tags } = post.data;
---

<MainLayout
  title={title}
  description={description}
  type='article'
  class='min-h-screen bg-slate-900'
>
  <div class='max-w-4xl mx-auto px-8 py-8'>
    <header class='mb-12'>
      <h1
        class='text-4xl font-bold text-white mb-6'
        style={`view-transition-name: post-title-${post.slug}`}
      >
        {title}
      </h1>

      <PostMeta
        post={post}
        content={content}
        class='mb-6 space-x-4'
      />

      {
        tags && tags.length > 0 && (
          <div class='flex flex-wrap gap-2 mb-6'>
            {tags.map(tag => (
              <Chip
                tag={tag}
                href={`/blog/tag/${tag}`}
                variant='secondary'
              />
            ))}
          </div>
        )
      }

      <p class='text-lg text-slate-300 leading-relaxed border-l-4 border-slate-500 pl-6 mb-8 bg-gradient-to-r from-transparent to-slate-500/10 py-2'>
        {description}
      </p>

      <Link
        href='/blog'
        class='inline-block text-slate-400 hover:text-white transition-all duration-300 mb-8 hover:translate-x-1'
      >
        ← 返回所有文章
      </Link>
    </header>

    <article
      class='prose prose-lg prose-invert prose-slate max-w-none prose-headings:text-white prose-a:text-slate-300 prose-a:hover:text-white prose-code:text-slate-300 prose-code:bg-slate-800/50 prose-blockquote:border-slate-500 prose-blockquote:text-slate-300'
    >
      <slot />
    </article>
  </div>
</MainLayout>
